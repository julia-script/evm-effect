{
  "name": "@evm-effect/rpc",
  "version": "0.1.2",
  "description": "Effect schemas for Ethereum JSON-RPC (OpenRPC / execution-apis)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/evm-effect.git",
    "directory": "packages/rpc"
  },
  "bugs": {
    "url": "https://github.com/julia-script/evm-effect/issues"
  },
  "homepage": "https://github.com/julia-script/evm-effect/tree/main/packages/rpc",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch",
    "check": "tsc -b tsconfig.json",
    "codegen": "tsx scripts/gen-schemas.ts"
  },
  "dependencies": {
    "@evm-effect/ethereum-types": "workspace:*",
    "effect": "catalog:",
    "ts-dedent": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@biomejs/js-api": "4.0.0",
    "@biomejs/wasm-nodejs": "2.4.15",
    "@biomejs/wasm-web": "2.4.15",
    "@effect/platform-node": "catalog:",
    "@types/node": "^24.8.1",
    "tsx": "^4.22.0",
    "typescript": "catalog:"
  }
}
