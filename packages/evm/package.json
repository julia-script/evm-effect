{
  "name": "@evm-effect/evm",
  "version": "0.2.2",
  "description": "Ethereum Virtual Machine implementation in TypeScript with Effect-TS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/evm-effect.git",
    "directory": "packages/evm"
  },
  "bugs": {
    "url": "https://github.com/julia-script/evm-effect/issues"
  },
  "homepage": "https://github.com/julia-script/evm-effect/tree/main/packages/evm",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch",
    "check": "tsc -b tsconfig.json",
    "test": "vitest run",
    "print-failed-tests": "tsx test/print-failed-tests.ts",
    "fixtures": "uvx --from git+https://github.com/ethereum/execution-specs#subdirectory=packages/testing consume cache --input=https://github.com/ethereum/execution-specs/releases/download/tests-bal%40v7.1.1/fixtures_bal.tar.gz --extract-to ./test/test-fixtures"
  },
  "dependencies": {
    "@evm-effect/crypto": "workspace:*",
    "@evm-effect/ethereum-types": "workspace:*",
    "@evm-effect/rlp": "workspace:*",
    "@evm-effect/rpc": "workspace:*",
    "@evm-effect/shared": "workspace:*",
    "@evm-effect/solc": "workspace:*",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "catalog:",
    "@noble/secp256k1": "^3.1.0",
    "effect": "catalog:",
    "kzg-wasm": "^0.5.0",
    "superjson": "^2.2.2",
    "ts-dedent": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/node": "^24.8.1",
    "fast-check": "catalog:",
    "tsx": "^4.22.0",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
