{
  "name": "@evm-effect/shared",
  "version": "0.0.7",
  "description": "Shared utilities (HashMap, HashSet, tracing) for evm-effect packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/evm-effect.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/julia-script/evm-effect/issues"
  },
  "homepage": "https://github.com/julia-script/evm-effect/tree/main/packages/shared",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./test": {
      "import": "./dist/test/index.js",
      "types": "./dist/test/index.d.ts"
    },
    "./test/*": {
      "import": "./dist/test/*.js",
      "types": "./dist/test/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch",
    "clean": "rm -rf build",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "superjson": "^2.2.2",
    "ts-dedent": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
