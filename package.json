{
  "name": "evm-effect",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clear": "./clear.sh",
    "codegen": "pnpm -r --parallel run codegen",
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "turbo check",
    "check-recursive": "pnpm -r exec tsc -b tsconfig.json",
    "test": "turbo test",
    "ci:version": "changeset version && pnpm install",
    "ci:publish": "pnpm run build && pnpm publish -r --access public --no-git-checks && changeset tag",
    "changeset-version": "pnpm run ci:version",
    "changeset-publish": "pnpm run ci:publish",
    "lint": "pnpm exec biome check .",
    "lint:fix": "pnpm exec biome check . --fix --unsafe",
    "biome:migrate": "pnpm exec biome migrate --write"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@biomejs/biome": "^2.4.15",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.0",
    "@manypkg/cli": "^0.25.1",
    "@noble/curves": "^2.0.1",
    "@types/node": "^24.8.1",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "c-kzg": "^4.1.0",
    "glob": "^11.1.0",
    "knip": "^5.88.1",
    "msgpackr": "^1.11.12",
    "skott": "^0.35.11",
    "tsx": "^4.22.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "c-kzg",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
